APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
# Preferred server-side key (sb_secret_...). Never expose this to Vite/browser code.
SUPABASE_SECRET_KEY=
# Legacy server-side alternative. A public anon key alone does not enable persistence.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
LLM_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GROUNDING=true
GEMINI_TIMEOUT_SECONDS=20
DATA_MODE=live
YAHOO_EXCHANGE_SUFFIX=.NS
MARKET_CACHE_TTL_SECONDS=900
NEWS_CACHE_TTL_SECONDS=1800
FUNDAMENTALS_CACHE_TTL_SECONDS=21600
